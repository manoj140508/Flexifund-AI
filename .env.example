# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Server-side AI Explainer API key (Never expose as NEXT_PUBLIC_*)
# The application runs fully deterministically if this is omitted.
AI_API_KEY=

# Production / Local PostgreSQL Database URL (Never expose as NEXT_PUBLIC_*)
# e.g. postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
